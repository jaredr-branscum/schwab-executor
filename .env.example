# Charles Schwab Developer API Credentials (developer.schwab.com)
SCHWAB_APP_KEY=YOUR_SCHWAB_APP_KEY_HERE
SCHWAB_APP_SECRET=YOUR_SCHWAB_APP_SECRET_HERE

# Registered OAuth Callback URL (must match developer portal setting)
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Path to cached OAuth token file
SCHWAB_TOKEN_PATH=.schwab_token.json

# Schwab API Base URL
SCHWAB_BASE_URL=https://api.schwabapi.com

# Target Schwab Account(s) Rebalance Filter:
# Set to 'all' to evaluate and execute across all linked Schwab accounts,
# or specify comma-separated account numbers / hashes / last 4 digits (e.g. 1234,5678)
SCHWAB_ACCOUNTS=all

# Execution Safety & Pre-Trade Risk Controls
# SCHWAB_DRY_RUN: Set to 'true' to simulate order placement without live broker submission
SCHWAB_DRY_RUN=true

# Maximum allowable single-order notional value in USD (pre-trade risk bound)
SCHWAB_MAX_ORDER_NOTIONAL=100000.0

# HTTP Network Request Timeout in milliseconds
SCHWAB_REQUEST_TIMEOUT_MS=5000

# Enable pre-warmed multi-threaded worker pool dispatch across multi-account portfolios
SCHWAB_CONCURRENT_DISPATCH=true

# Maximum concurrent worker threads for simultaneous account dispatch (bounds resource usage)
SCHWAB_MAX_CONCURRENT_WORKERS=8

# Cash Conservation & Margin Debt Guardrails:
# Enforce aggregate buy order commitments <= available cash + anticipated sell proceeds
SCHWAB_ENFORCE_CASH_LIMITS=true

# Prohibit unintended margin debt by rejecting buy orders that exceed cash purchasing power
SCHWAB_ALLOW_MARGIN_BORROWING=false

# Pre-Trade Price & Spread Risk Thresholds:
# Maximum allowable price deviation collar percent (e.g. 0.05 = 5.0%)
SCHWAB_PRICE_COLLAR_PERCENT=0.05

# Maximum allowable NBBO bid-ask spread in basis points (e.g. 15.0 = 0.15%)
SCHWAB_MAX_SPREAD_BPS=15.0

# Post-Dispatch Execution Fill Reconciliation:
# Poll broker post-submission to verify fill status, execute slippage calculation, and detect partials
SCHWAB_TRACK_FILLS=false
SCHWAB_FILL_POLL_INTERVAL_MS=100
SCHWAB_FILL_POLL_TIMEOUT_MS=5000

# Telemetry & Structured Audit Logging:
# Path to append persistent execution reports and order latency telemetry
# SCHWAB_TELEMETRY_LOG_PATH=logs/execution_telemetry.log

# Target Portfolio Allocations (Optional, for generic configuration-driven rebalancing)
# Comma-separated 'SYMBOL:WEIGHT' pairs (e.g. SPY:0.60,QQQ:0.40)
# SCHWAB_STRATEGY_TARGETS=SPY:0.60,QQQ:0.40
