# Charles Schwab Developer API Credentials (developer.schwab.com)
SCHWAB_APP_KEY=YOUR_SCHWAB_APP_KEY_HERE
SCHWAB_APP_SECRET=YOUR_SCHWAB_APP_SECRET_HERE

# Registered OAuth Callback URL (must match developer portal setting)
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Path to cached OAuth token file
SCHWAB_TOKEN_PATH=.schwab_token.json

# Schwab API Base URL
SCHWAB_BASE_URL=https://api.schwabapi.com